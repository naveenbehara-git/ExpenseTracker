@page
@model ExpenseTracker.Pages.EditModel
@{
    ViewData["Title"] = "Edit expense";
}

<div class="page-header">
    <a class="back-link" asp-page="/Index">← Back to expenses</a>
    <p class="eyebrow">Update record</p>
    <h1>Edit expense</h1>
    <p class="lede">Adjust the details below, then save your changes.</p>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
}

<section class="content-card form-card" aria-labelledby="form-heading">
    <h2 id="form-heading" class="visually-hidden">Expense details</h2>
    <form method="post">
        <input type="hidden" asp-for="Input.Id" />
        <partial name="_ExpenseForm" model="Model.Input" />
        <div class="form-actions">
            <a class="button button-quiet" asp-page="/Index">Cancel</a>
            <button class="button button-primary" type="submit">Save changes</button>
        </div>
    </form>
</section>
