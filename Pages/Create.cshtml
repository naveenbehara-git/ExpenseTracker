@page
@model ExpenseTracker.Pages.CreateModel
@{
    ViewData["Title"] = "Add expense";
}

<div class="page-header">
    <a class="back-link" asp-page="/Index">← Back to expenses</a>
    <p class="eyebrow">New record</p>
    <h1>Add an expense</h1>
    <p class="lede">Capture the details while they are fresh. You can edit anything later.</p>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
}

<section class="content-card form-card" aria-labelledby="form-heading">
    <h2 id="form-heading" class="visually-hidden">Expense details</h2>
    <form method="post">
        <partial name="_ExpenseForm" model="Model.Input" />
        <div class="form-actions">
            <a class="button button-quiet" asp-page="/Index">Cancel</a>
            <button class="button button-primary" type="submit">Save expense</button>
        </div>
    </form>
</section>
